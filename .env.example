# Privy dashboard -> App settings -> App ID. Public by design.
VITE_PRIVY_APP_ID=

# Optional override. The verified Studionet preview deployment is built in.
VITE_GENLAYER_CONTRACT_ADDRESS=
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Leave blank in production so the Worker API is same-origin.
# Set to http://localhost:8787 only while running `npm run dev:worker`.
VITE_EVOLUTION_API_URL=

# Worker secrets are configured with `npx wrangler secret put`, not here:
# TURNSTILE_SECRET_KEY (only after adding a client Turnstile challenge)
